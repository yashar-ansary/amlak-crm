# پورت اجرای سامانه پارس‌ملک (پیش‌فرض: ۳۰۰۰)
PORT=3000

# حالت اجرا: production یا development
NODE_ENV=production

# کلید اختصاصی Google Gemini API (حیاتی و الزامی برای تبدیل صوت به متن در آیفون / iOS Safari)
# مرورگر آیفون (Safari) فاقد وب‌اسپیچ فارسی است؛ لذا فایل صوتی را برای پیاده‌سازی متنی به سرور می‌فرستد.
# دریافت رایگان کلید: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# آدرس دامنه اصلی سامانه همراه با پروتکل امن HTTPS جهت دسترسی به میکروفون
APP_URL="https://your-domain.com"
