# پورت اجرای سامانه پارس‌ملک (پیش‌فرض: ۳۰۰۰)
PORT=3000

# حالت اجرا: production یا development
NODE_ENV=production

# آدرس دامنه اصلی سامانه همراه با پروتکل امن HTTPS جهت دسترسی به میکروفون در آیفون
APP_URL="https://your-domain.com"

# کلید هوش مصنوعی جمینای جهت تبدیل صوت آیفون به متن فارسی در بستر سرور و داکر (ضروری برای iOS Safari)
# دریافت رایگان در کمتر از ۱ دقیقه از کنسول گوگل: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
